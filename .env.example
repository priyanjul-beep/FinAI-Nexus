# FinAI Nexus Environment Configuration

# System Settings
PROJECT_NAME="FinAI Nexus"
VERSION="1.0.0"
ENVIRONMENT="development"
DEMO_MODE=true
DEBUG=true
LOG_LEVEL="INFO"

# API & Security
API_V1_STR="/api/v1"
SECRET_KEY="finai-nexus-super-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM="HS256"

# Database Configuration
# For local dev / fallback without Docker, SQLite can be used or PostgreSQL:
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=finai_nexus
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
DATABASE_URL="sqlite:///./finai_nexus.db"
# Production Postgres URL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finai_nexus"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# LLM Provider Options: "mock", "openai", "gemini"
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# Embedding Provider Options: "mock", "openai", "gemini", "huggingface"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"

# Vector Search Configuration
VECTOR_SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Responsible AI Guardrails
STRICT_CITATION_CHECK=true
MAX_HALLUCINATION_SCORE=0.25
PROMPT_INJECTION_PROTECTION=true
